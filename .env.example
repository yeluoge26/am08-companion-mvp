# Use Node.js 24+. Start with: node --env-file=.env server.mjs
HOST=127.0.0.1
# Server-only chat credentials. Never place a real key in public files.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PORT=4180
PUBLIC_ORIGIN=http://127.0.0.1:4180
NODE_ENV=development
# Production: HTTPS public origin, reverse proxy, persistent DATA_DIR and backups.
# DATA_DIR=/var/lib/candy-mvp
# ADMIN_EMAIL=operator@example.com
# ADMIN_PASSWORD=replace-with-a-unique-long-password
# BILLING_WEBHOOK_SECRET=replace-with-at-least-32-random-bytes
# CHECKOUT_URL=https://your-payment-adapter.example/checkout
ALLOW_MANUAL_SETTLEMENT=false
# Optional email adapter: HTTPS POST {to,subject,text}, Bearer token authentication.
# MAIL_WEBHOOK_URL=https://your-mail-adapter.example/send
# MAIL_WEBHOOK_TOKEN=replace-with-a-random-adapter-token
# Development-only: save outgoing messages to private DATA_DIR/outbox, never public.
# MAIL_MODE=outbox

# Only enable behind local Nginx that overwrites X-Real-IP.
# TRUST_PROXY_LOOPBACK=true
